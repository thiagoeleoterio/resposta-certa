# Environment variables for Resposta Certa

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Cost per 1M tokens (USD)
AI_INPUT_COST_PER_1M_USD=10
AI_OUTPUT_COST_PER_1M_USD=30

# Exchange rate USD to BRL (used for cost display)
EXCHANGE_RATE_USD_BRL=5.2

# Next.js public variables (prefixed with NEXT_PUBLIC_)
# These are exposed to the browser - never put secrets here!

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application
NEXT_PUBLIC_MAX_INPUT_LENGTH=500